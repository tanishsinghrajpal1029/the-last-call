   "sha256": "c70a174de50c45af19d1eb492730717b829799f08a0905399aae4b9f6ed61bf8",
   "text": "I can hear you breathing."
  },
  "clear_6": {
   "bytes": 11198,
   "sha256": "211b721c3cfd1096975140ff11b153a0cf01cf9f7335427a3cb65e0b81b9816d",
   "text": "It's really me. I promise."
  },
  "clear_7": {
