  "stage_goal": {
   "bytes": 36798,
   "sha256": "a48250eb33f10b690a892429a6095912b7d9391f1802508e62242e4d91659a3c",
   "text": "Every call, two questions. Who is calling, and which door. Listen to learn who. Trace to learn where."
  },
  "stage_superposition": {
   "bytes": 28047,
   "sha256": "49a43017f55d9a910bcd8291503c0f68c11bd38b560024137262075081e79c8f",
   "text": "One call. Two doors. She is at both of them at once. That is superposition."
  },
  "stage_listen": {
   "bytes": 15639,
   "sha256": "a5e278c39a3673f81173414616694ae76b664adf35a2ad62a1a118f3119ea3d7",
   "text": "Set the dial to zero, and press Listen."
  },
  "stage_interference": {
   "bytes": 16553,
   "sha256": "2048da7abd29f8fe10c9e6181aa19301f604508fc826bad6a34cd03a22174da6",
   "text": "Now turn the dial to four, and listen again."
  },
  "stage_impostor": {
   "bytes": 29876,
   "sha256": "bca973aa6b4ff34712b5f3c23dc8cf6340e883300c36c93043df06029803c3c9",
   "text": "An impostor's pattern is shifted. Where Mira comes through clear, it gives static."
  },
  "stage_trace": {
   "bytes": 21255,
   "sha256": "772345cf168f18c4a6449fddb34c6279078d88b23479911f2d188223ce84da39",
   "text": "Now trace the call. You will learn the door, and lose the pattern."
  },
  "stage_decide": {
   "bytes": 15639,
   "sha256": "9f81edf19c2dcda63bc4941e6bef9a5351569214f8d476a62a74f92873d2d1ad",
