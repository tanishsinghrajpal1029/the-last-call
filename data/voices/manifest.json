  "intro_1": {
   "bytes": 126268,
   "sha256": "c5a197703c569e3fef5b723919ceec9072ba602bf5219f63df1ab4cb838fe386",
   "text": "11:52 pm. Mum and Dad are stuck across town in the storm, and you're watching your little sister Mira. Twenty minutes ago she slipped outside after the cat. Now the intercom crackles: both door cameras show the same dark, hooded shape, at the front door and the side door, at the same time. The night vision can't make out a face. One call, two doors."
  },
  "intro_2": {
   "bytes": 57566,
   "sha256": "b599907d8ea0b3fbc27a173fa2a4d979402bdcf237b8de6b8cc97758a8c3e9f1",
   "text": "12:20 am. She calls again. Same dark shape, same little voice, both doors. Mum's rule, taped to the fridge: “Never open the door at night unless you're sure who it is.”"
  },
  "intro_3": {
   "bytes": 43851,
   "sha256": "243f8532707faecab0b3ba4777ccdc82894ed6f108b942288822af419850965a",
   "text": "1:05 am. The porch light on one side won't stop flickering. Another call. Tonight the call leans toward one of the doors."
  },
  "intro_4": {
   "bytes": 51035,
   "sha256": "6c32367222a791c69f99fb9c6d5fca5f9b2227351d06873b7530d50756041613",
   "text": "3:33 am. The intercom battery is almost dead. One more call. Somewhere out in the rain, something has learned exactly how she says your name."
  },
  "res_saved": {
   "bytes": 6757,
   "sha256": "bcd9213a064359dc5173cdd0454aac71819e837b2e7083fbec82007b4389d80a",
   "text": "You took forever."
  },
  "res_wrong": {
   "bytes": 5713,
   "sha256": "1f79cfcd6e8fdd2a4a7f747142ba87cf53212d2b3760f59194723b2f56ee8e3e",
   "text": "Wrong one."
  },
  "mimic_next": {
   "bytes": 9892,
   "sha256": "81a53f4f7667ab83fff201bb8ccc02bc00c9afdd18acebc7524a9e1325d81c42",
   "text": "Next time."
  },
  "mimic_thanks": {
   "bytes": 8717,
   "sha256": "2661cdac4ad244b147c83805ac534a502f3cb8ffc1441810aa2cf6950569833d",
   "text": "Thank you."
  },
  "mimic_letmein": {
   "bytes": 9762,
   "sha256": "728152bd580addaebe4f2e47a1a8afda5379a167da8b9db7695c5fffd631ad8d",
   "text": "Let me in."
  },
  "stage_goal": {
   "bytes": 61353,
   "sha256": "2513a970cd727508e4131c2d139b73de7929be84c41c3658e69ef1b132504daf",
   "text": "Someone is outside. Use the intercom to find out who it is and which door, then let Mira in through the right door, or hang up on the mimic. Listen to learn who. Trace to learn where."
  },
  "stage_superposition": {
   "bytes": 29353,
   "sha256": "b4487cfd0dc18728f21988dcf49b6601660ec6cceb2644c70edfe3c267d63d77",
   "text": "One call. Two doors. She is at both of them at once. That is superposition."
  },
  "stage_listen": {
   "bytes": 15117,
   "sha256": "7521eadcf91a3742f1a8e127cf616fa52bba36975096007e627e2abfb1085a61",
   "text": "Set the dial to zero, and press Listen."
  },
  "stage_interference": {
   "bytes": 15247,
   "sha256": "06e05a7744eff3ea0a3bcce7f40a1bc352603710fde6886d4fa9460034fa4e9c",
   "text": "Now turn the dial to four, and listen again."
  },
  "stage_impostor": {
   "bytes": 26480,
   "sha256": "aa9e322c77321d45f98efab8d83ac0692ad6769abae6bc53a1c0f81059b5fde0",
   "text": "An impostor's pattern is shifted. Where Mira comes through clear, it gives static."
  },
  "stage_trace": {
   "bytes": 22039,
   "sha256": "aefd8086d3d993b5eaf14a005e3a9777a036463a03e2ef146dc1915fec725afd",
   "text": "Now trace the call. You will learn the door, and lose the pattern."
  },
  "stage_decide": {
   "bytes": 16292,
   "sha256": "5cbec856a3e232f745cf2202a666f8c8debc32edd85ed2a735e9e510494be036",
   "text": "Tonight, either door is safe. Open one."
  },
  "tut_listen_clear": {
   "bytes": 24651,
   "sha256": "3daf3a7e4656b64d2b5ec7202e5a5d092d090cb0065b53044027d8bc5a616456",
   "text": "Clear. Her voice came through both doors in step, and the two halves added up."
  },
  "tut_listen_static": {
   "bytes": 42545,
   "sha256": "41bba05367fbad69409da84587e02a61e70b096f378dd14fb3d026c0f5f8938d",
   "text": "Static. At dial zero that's rare: one noisy shot. Each call is random, so one listen is never the whole story."
  },
  "tut_dial4_static": {
   "bytes": 23737,
   "sha256": "84ff580e145466d45b10470f3663007a8cbf6919dcb8bb57996ba2f552f36a31",
   "text": "Static. Half a turn out of step, the two halves cancel each other out."
  },
  "tut_dial4_clear": {
   "bytes": 35753,
   "sha256": "3f05b796185298f48a5ead768808bcebf522be2751f612e2461467631eb690f9",
   "text": "Clear, by chance. Out of step, she should mostly cancel. Patterns show up over several listens."
  },
  "tut_trace": {
   "bytes": 38366,
   "sha256": "20935f5a43e8d67b40bd613b66d501bfa6b95efeddca48d4922657161dc049ed",
   "text": "The trace found the door. But now the line is a coin flip, whoever is calling. Knowing where cost you who."
  },
  "door_hello": {
   "bytes": 5713,
   "sha256": "570a62e2025a613a0c234379f062a2262d9adbfb07c0b9b13cf742a5f5ef8e1b",
   "text": "Hello?"
  },
  "door_still": {
   "bytes": 7802,
   "sha256": "30514f62e8c50e563dd23d990bd3d3826965e92eb69c6098e75fc04ad1ff8161",
   "text": "Are you still there?"
  },
  "door_light": {
   "bytes": 9370,
   "sha256": "d5ebcc3d6310595fb326f2cd4aca1b3126b77f51b502b4d921e9c6b7c4989b32",
   "text": "I can see your light on."
  }
 }
