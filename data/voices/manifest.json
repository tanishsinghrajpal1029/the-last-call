   "sha256": "5af9b1ad7776745b478e3281a56bfa2352e040b5513d392bdc0136fdb42c30ee",
   "text": "Please. It's so dark out here."
  },
  "clear_4": {
   "bytes": 7280,
   "sha256": "e405432e6ca333064bebfba8b254965ad9307622ea76582804803bb91c245a9d",
   "text": "Why aren't you opening?"
