  },
  "clear_11": {
   "bytes": 4668,
   "sha256": "8abd9241a8a1a036d58ad88915dedc8e0c59758f16256394051f09644bee0bff",
   "text": "Let me in."
  },
  "static_0": {
   "bytes": 6104,
