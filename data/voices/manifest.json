   "sha256": "1258223206df79ab615b0f82f2decb00f428d9dc98fe5e7aed12acb2d36c39df",
   "text": "I couldn't find the cat."
  },
  "clear_3": {
   "bytes": 13157,
   "sha256": "df8d7349471ba2cd4e9ec41601e40d2229be6a56abe86877ccb0a7454a22fa16",
   "text": "Please. It's so dark out here."
  },
  "clear_4": {
   "bytes": 6627,
   "sha256": "71dd9f63203c6ebed1580a605d8691aaaa3f3359fc0f291f397f96594ea50062",
   "text": "Why aren't you opening?"
  },
  "clear_5": {
   "bytes": 7280,
   "sha256": "d69350e8af238170b7bcf9b894bc5a904558454b946b6cc434f0892a25c4989f",
   "text": "I can hear you breathing."
  },
  "clear_6": {
   "bytes": 10153,
   "sha256": "4751428efa54a10b1c4735e81553556b2e159c01343932e7b5b8ee324b539c13",
   "text": "It's really me. I promise."
  },
  "clear_7": {
   "bytes": 6627,
   "sha256": "2715b2c53c1acaf1a58525be10462ffc74078b04488e5dfcc1623a651b061df8",
   "text": "Don't leave me out here."
  },
  "clear_8": {
   "bytes": 6496,
   "sha256": "c17ee9deaeefe00a9ca78a36fdb2f6ca190a08e098a1fe885eedfa1eb4be9140",
   "text": "You know my voice."
  },
  "clear_9": {
   "bytes": 12243,
   "sha256": "19b9c454156ec866e2588efcc2ba46693a67babd77c2e6914d9c2b73264e36e3",
   "text": "I'm right here. Right by the door."
  },
  "clear_10": {
