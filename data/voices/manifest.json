  "stage_goal": {
   "bytes": 36668,
   "sha256": "d1c119476091f64ca5f9f68749e1c2e05d0f4de4156547abb23393553264629e",
   "text": "Every call, two questions. Who is calling, and which door. Listen to learn who. Trace to learn where."
  },
  "stage_superposition": {
   "bytes": 30398,
   "sha256": "171965c70725fcdffe38fa6cbdeec78e0d9b85adb8928d88ba90208112277ca1",
   "text": "One call. Two doors. She is at both of them at once. That is superposition."
  },
  "stage_listen": {
   "bytes": 14202,
   "sha256": "bce7551f661dd1988c5e170e3b7d5cc29303295e2df27a85746e280295958e1c",
   "text": "Set the dial to zero, and press Listen."
  },
  "stage_interference": {
   "bytes": 20733,
   "sha256": "4a650ba956219365e708f972d663e885614df02926861b4b549da5fb9c7050ca",
   "text": "Now turn the dial to four, and listen again."
  },
  "stage_impostor": {
   "bytes": 27133,
   "sha256": "1754c9615653784d2b010cfbf68b023fb5b8a0ea979dfa0f1fb5360dbe9e21c2",
   "text": "An impostor's pattern is shifted. Where Mira comes through clear, it gives static."
  },
  "stage_trace": {
   "bytes": 21125,
   "sha256": "03ad1bb30667764053ce91b9900fd85bace95ad3a944f23c5e8a8efb13aae43d",
   "text": "Now trace the call. You will learn the door, and lose the pattern."
  },
  "stage_decide": {
   "bytes": 16553,
   "sha256": "7cbad7e2922ddb3f99f6063787977d5873903878342194147e4177e29dc7d863",
   "text": "Tonight, either door is safe. Open one."
  }
