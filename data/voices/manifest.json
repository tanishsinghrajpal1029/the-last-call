  "stage_goal": {
   "bytes": 33794,
   "sha256": "02a7688ceab4dad8cc721299d26682da18ab9350ae52b0a2780a8fb39cefae47",
   "text": "Every call, two questions. Who is calling, and which door. Listen to learn who. Trace to learn where."
  },
  "stage_superposition": {
   "bytes": 30660,
   "sha256": "93fb17a7a7a7f9ab55befbeabd8f5c8d446e36b990b5981ed647b0c048a09112",
   "text": "One call. Two doors. She is at both of them at once. That is superposition."
  },
  "stage_listen": {
   "bytes": 17206,
   "sha256": "2cc84b4c576c415d56c8bd67802d4d4f107a9015a826dbe44b9b27a277faefe3",
