  "clear_5": {
   "bytes": 6627,
   "sha256": "fc6aead159e4852a57132fbe7a5093dae065e7096b1313dc72c9be36340314dd",
   "text": "I can hear you breathing."
  },
  "clear_6": {
   "bytes": 11851,
   "sha256": "a8446fa6afdded43cc7b1144647b8936fd3a0b5c928331737892e6a058a2d357",
   "text": "It's really me. I promise."
  },
  "clear_7": {
   "bytes": 7149,
