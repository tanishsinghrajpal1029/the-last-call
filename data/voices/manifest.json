   "sha256": "6010c39f15076e5ebc47427c314571bdb368701e891445ff555e0f1ec4371bc9",
   "text": "Please. It's so dark out here."
  },
  "clear_4": {
   "bytes": 7280,
   "sha256": "dca3068310fb90757fe61d2f165041783de5717a1466343ea8d2e2e585725356",
   "text": "Why aren't you opening?"
