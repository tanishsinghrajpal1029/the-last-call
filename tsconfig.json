{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "rootDir": ".",
    "outDir": "build/js",
    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["packages/*/src/**/*.ts", "apps/web/src/**/*.ts"]
}
